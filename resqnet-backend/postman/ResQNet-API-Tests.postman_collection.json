{
  "info": {
    "_postman_id": "resqnet-phase1-api-tests",
    "name": "ResQNet API Tests",
    "description": "Complete API testing collection for ResQNet Phase 1 backend.\n\n**Setup**\n1. Start backend: `mvnw spring-boot:run` (port 8071)\n2. Set `DB_USERNAME` and `DB_PASSWORD` env vars\n3. Import this collection into Postman\n4. Run **Sample Flow** first (in order) — do NOT run Assignments until IDs exist\n\n**Important:** If you use the ResQNet Local environment, IDs are saved to BOTH collection and environment after each CREATE. URLs like `/api/admin//assign/` mean a variable is empty — run Sample Flow create steps first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8071" },
    { "key": "incidentId", "value": "" },
    { "key": "teamId", "value": "" },
    { "key": "volunteerId", "value": "" },
    { "key": "campId", "value": "" },
    { "key": "resourceId", "value": "" },
    { "key": "teamAssignmentId", "value": "" },
    { "key": "volunteerAssignmentId", "value": "" },
    { "key": "resourceAssignmentId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const resolved = pm.request.url.toString();",
          "const path = resolved.replace(/^https?:\\/\\/[^/]+/, '');",
          "const hasEmptySegment = /\\/\\//.test(path) || /\\/(incidents|volunteers|resources|camps|teams|assignments)\\/$/.test(path);",
          "if (hasEmptySegment) {",
          "    throw new Error(",
          "        'Empty ID in URL: ' + path + '. Run Sample Flow create requests first (steps 1-8). ' +",
          "        'If using an environment, re-run creates so incidentId/teamId/campId are populated.'",
          "    );",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Sample Flow",
      "description": "Run these requests in order for an end-to-end disaster response scenario.",
      "item": [
        {
          "name": "1 - CreateIncident",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"FLOOD\",\n  \"severity\": 4,\n  \"reporter\": \"Citizen Hotline\",\n  \"latitude\": 28.6139,\n  \"longitude\": 77.2090\n}"
            },
            "url": "{{baseUrl}}/api/incidents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created incident', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.id) { pm.collectionVariables.set('incidentId', body.id); pm.environment.set('incidentId', body.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "2 - RegisterTeam",
